{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/pre-execution.js\"",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/pre-execution.js\"",
        "timeoutSec": 15
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "edit|create|write|replace|patch|insert",
        "command": "node \"${PLUGIN_ROOT}/hooks/post-execution.js\"",
        "timeoutSec": 90
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/post-execution.js\" --summary-hook",
        "timeoutSec": 15
      }
    ]
  }
}
